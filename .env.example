# CampusFlow Production Environment Variables Template
# Copy these environment variables to your Render Web Service Environment Settings

# Environment & Server Binding
NODE_ENV=production
# Note: Render automatically assigns PORT dynamically. Leave PORT blank or omit in Render env settings.
PORT=3000

# MongoDB Atlas Database Connection URI
# Ensure MongoDB Atlas -> Network Access includes 0.0.0.0/0 (Allow Access from Anywhere)
MONGODB_URI=mongodb+srv://admin:YourPasswordHere@cluster0.bhegzgn.mongodb.net/campusflow?retryWrites=true&w=majority&appName=Cluster0

# JSON Web Token Secret Key (Use a strong random string)
JWT_SECRET=campusflow_super_secret_jwt_key_2026_prod_edition

# Automated Parent Email Notification SMTP Configuration (Gmail / SendGrid / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@campusflow.klh.edu.in
SMTP_PASS=your_app_specific_password
SMTP_FROM="CampusFlow Security Portal <notifications@campusflow.klh.edu.in>"

