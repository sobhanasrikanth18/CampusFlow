# CampusFlow Environment Variables Configuration Template
# Duplicate this file to .env in production

# Environment & Server Binding
NODE_ENV=production
PORT=3000

# MongoDB Atlas Database Connection URI
# Replace with your cluster connection string. Passwords with '@' must be encoded as '%40'
MONGODB_URI=mongodb+srv://admin:Shoban%4080@cluster0.bhegzgn.mongodb.net/campusflow?appName=Cluster0

# JSON Web Token Secret Key (Change to a cryptographically secure random string in production)
JWT_SECRET=campusflow_super_secret_jwt_key_2026_prod_edition

# Automated Parent Email Notification SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@campusflow.klh.edu.in
SMTP_PASS=your_app_specific_password
SMTP_FROM="CampusFlow Security Portal <notifications@campusflow.klh.edu.in>"
